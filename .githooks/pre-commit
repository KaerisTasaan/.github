#!/bin/sh
# Run gomarklint on Markdown files before commit.
# Skip when no staged file is Markdown. Continuous integration still lints Markdown on every pull request except a title edit.
# gomarklint skips hidden directories when it walks `.`. Pass `.github/ISSUE_TEMPLATE` so those files are checked. Keep `.gomarklint.json` include as `.`.
cd "$(git rev-parse --show-toplevel)" || exit 1
if ! git diff --cached --name-only --diff-filter=ACM | grep -q '\.md$'; then
	exit 0
fi
exec go run github.com/shinagawa-web/gomarklint/v3@v3.2.3 --config .gomarklint.json . .github/ISSUE_TEMPLATE
